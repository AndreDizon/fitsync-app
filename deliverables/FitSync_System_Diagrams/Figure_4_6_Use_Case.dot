digraph UseCases {
  graph [rankdir=LR, bgcolor=white, pad=0.35, nodesep=0.55, ranksep=0.6, splines=line, fontname="Arial", fontsize=22, fontcolor="#142b55", labelloc=t, label="Figure 4.6: FitSync Use-Case Diagram"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=13, color="#254574", penwidth=1.3, margin="0.20,0.16"];
  edge [arrowhead=none, color="#254574", penwidth=1.3];
  user [fillcolor="#e6effc", label="Registered user", width=1.7];
  member [fillcolor="#edeafa", label="Gym member", width=1.7];
  staff [fillcolor="#e1f3e8", label="Gym staff", width=1.7];
  admin [fillcolor="#fff2d4", label="Gym admin / owner", width=1.7];
  {rank=same; user; member; staff; admin;}
  subgraph cluster_system {
    label="FitSync Web Application"; fontsize=17; fontcolor="#142b55"; color="#254574"; penwidth=1.5; margin=18;
    personal [fillcolor="#e6effc", label=<<B>PERSONAL USER FEATURES</B><BR/>Manage account and onboarding | Plan workouts and meals<BR/>Save playlists | Browse libraries and articles | Take quizzes<BR/>Log progress and water | Review insights and achievements<BR/>Use community posts, reminders and educational AI chat>];
    participation [fillcolor="#edeafa", label=<<B>GYM MEMBER FEATURES</B><BR/>View gym details, rules and team | Check in and out<BR/>Review own visits and membership | Reserve activity places<BR/>Chat, read announcements and share playlists>];
    operations [fillcolor="#e1f3e8", label=<<B>GYM STAFF FEATURES</B><BR/>Use member features | Accept or decline join requests<BR/>Apply existing plans and renew coverage<BR/>Manage announcements and moderate discussion>];
    ownership [fillcolor="#fff2d4", label=<<B>GYM ADMIN FEATURES</B><BR/>Manage gym, requests, members and staff roles<BR/>Confirm check-ins | Schedule events and group sessions<BR/>Manage plan offers and coverage | Record payments<BR/>Review balances, collections and activity | Transfer or delete gym>];
    {rank=same; personal; participation; operations; ownership;}
  }
  user -> personal; member -> participation; staff -> operations; admin -> ownership;
}
