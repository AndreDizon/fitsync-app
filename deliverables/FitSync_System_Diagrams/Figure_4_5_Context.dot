digraph Context {
  graph [rankdir=LR, bgcolor=white, pad=0.35, nodesep=0.65, ranksep=0.8, splines=polyline, fontname="Arial", fontsize=22, fontcolor="#142b55", labelloc=t, label="Figure 4.5: FitSync Context Diagram"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=13, color="#47658a", penwidth=1.3, margin="0.20,0.16"];
  edge [fontname="Arial", fontsize=11, color="#47658a", arrowsize=0.7, dir=both];
  users [fillcolor="#eef4fc", label="Registered users"];
  team [fillcolor="#e4f3e9", label="Gym members and staff"];
  owner [fillcolor="#fff2d4", label="Gym admin / owner"];
  app [fillcolor="#e6effc", label=<<B>FITSYNC</B><BR/><BR/>Workout and nutrition planning<BR/>Progress tracking and learning<BR/>Community and gym management>, width=3.8, height=1.7];
  services [fillcolor="#fff2d4", label=<<B>External services</B><BR/><BR/>Google sign-in and Gmail<BR/>OpenRouter AI<BR/>Article publisher websites>];
  {rank=same; users; team; owner;}
  users -> app [label="Account details, preferences and logs\nPlans, learning content and insights"];
  team -> app [label="Join requests, visits and reservations\nGym updates and membership information"];
  owner -> app [label="Gym settings, decisions and payment records\nMember records, attendance and collections"];
  app -> services [label="Identity, email, chat and article requests\nAuthorization, delivery status and content"];
}
