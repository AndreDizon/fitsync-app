digraph DataFlow {
  graph [rankdir=LR, bgcolor=white, pad=0.35, nodesep=0.40, ranksep=0.95, splines=polyline, fontname="Arial", fontsize=22, labelloc=t, label="Figure 4.7: FitSync Data-Flow Diagram, Level 0"];
  node [fontname="Arial", fontsize=12, color="#334155", margin="0.17,0.12"];
  edge [fontname="Arial", fontsize=11, arrowsize=0.65, color="#475569", constraint=false];
  user [shape=box, label="Registered user\n(including gym roles)"];
  participant [shape=box, label="Gym member / staff"];
  operators [shape=box, label="Gym admin / staff\n(role-checked actions)"];
  admin [shape=box, label="Gym admin / owner"];
  google [shape=box, label="Google identity service"];
  gmail [shape=box, label="Gmail API"];
  ai [shape=box, label="OpenRouter"];
  publishers [shape=box, label="Article publishers"];
  node [shape=box, style="rounded,filled", fillcolor="#edf3fa", penwidth=1.3];
  p1 [label="1.0\nManage account\nand preferences"];
  p2 [label="2.0\nManage plans, playlists\nand daily logs"];
  p3 [label="3.0\nProvide reference\nand quiz content"];
  p4 [label="4.0\nMaintain progress\nand calculate insights"];
  p5 [label="5.0\nManage community,\ngym access and attendance"];
  p6 [label="6.0\nManage membership\ncoverage and collections"];
  p7 [label="7.0\nProvide reminders\nand educational chat"];
  node [shape=record, style=solid, fillcolor=white, penwidth=1.1];
  d1 [label="D1 | Accounts and preferences\nAuth identities, profile and sessions"];
  d2 [label="D2 | Plans, playlists and daily logs\nExercise, food, actual sets and water"];
  d3 [label="D3 | Progress and awards\nMeasurements, check-ins, notes and private photos"];
  d4 [label="D4 | Community and gym records\nPosts, roles, rules, chat, activities and visits"];
  d5 [label="D5 | Membership and ledger records\nPlan offers, coverage, payments and refunds"];
  d6 [label="D6 | Reference collections\nExercise / food data, article links and quiz bank"];
  d7 [label="D7 | Device state\nReminder preferences/history and offline copies"];
  {rank=min; user; participant; operators; admin;}
  {rank=same; p1; p2; p3; p4; p5; p6; p7;}
  {rank=max; d1; d2; d3; d4; d5; d6; d7; google; gmail; ai; publishers;}
  user -> p1 -> d1 [style=invis, constraint=true, weight=100];
  p1 -> p2 -> p3 -> p4 -> p5 -> p6 -> p7 [style=invis, weight=30];
  user -> p1 [label="Registration, credentials, codes;\nonboarding and account changes"];
  p1 -> user [label="Access / profile / account-action results", constraint=false];
  p1 -> d1 [label="Account and profile changes"];
  d1 -> p1 [label="Identity, profile and session records", constraint=false];
  p1 -> google [label="Identity request"];
  google -> p1 [label="Identity authorization", constraint=false];
  p1 -> gmail [label="Verification / recovery email request"];
  gmail -> p1 [label="Delivery result", constraint=false];
  user -> p2 [label="Plan / playlist edits;\ncompletion and actual logs"];
  d1 -> p2 [label="Planning preferences"];
  d6 -> p2 [label="Exercise / food reference data"];
  p2 -> d2 [label="Saved plans, playlists and logs"];
  d2 -> p2 [label="Existing schedules and routines", constraint=false];
  p2 -> d7 [label="Saved device copies and pending changes"];
  d7 -> p2 [label="Cached plans and playlists"];
  p2 -> user [label="Editable plans; daily totals; sync status", constraint=false];
  user -> p3 [label="Search, topic, level and answer choice"];
  d6 -> p3 [label="Catalogues, links and answer keys"];
  p3 -> user [label="Details; article links; quiz feedback and score", constraint=false];
  p3 -> publishers [label="Selected article page request"];
  publishers -> p3 [label="External article page", constraint=false];
  user -> p4 [label="Measurements, recovery, notes, photos;\nperiod filters and award claims"];
  d2 -> p4 [label="Completed plans and actual logs"];
  d1 -> p4 [label="Goal and profile context"];
  p4 -> d3 [label="Progress entries, photos and claimed awards"];
  d3 -> p4 [label="Recorded history and awards", constraint=false];
  p4 -> user [label="Analytics, estimates, history,\nphoto views and CSV export", constraint=false];
  user -> p5 [label="Forum posts, introductions;\ngym discovery / creation / join data"];
  participant -> p5 [label="Own visits; reservations;\ngym messages and shared playlists"];
  operators -> p5 [label="Join decisions and moderation"];
  admin -> p5 [label="Settings, roles, bans; visit confirmations;\nevent schedules and roster requests"];
  p5 -> d4 [label="Community, role, activity and visit changes"];
  d4 -> p5 [label="Membership role; community and visit records", constraint=false];
  p5 -> user [label="Community content and gym search results", constraint=false];
  p5 -> participant [label="Gym information; own visits;\nreservation results and community updates", constraint=false];
  p5 -> admin [label="Member / activity / visit histories; preregistrations", constraint=false];
  operators -> p6 [label="Existing-plan assignment and renewal"];
  admin -> p6 [label="Plan offers; coverage edits;\nreceived payments / refunds / corrections"];
  participant -> p6 [label="Available plans / own coverage requests"];
  d4 -> p6 [label="Gym role and member identity"];
  p6 -> d5 [label="Plan, coverage and ledger changes"];
  d5 -> p6 [label="Fees, periods and payment ledger", constraint=false];
  p6 -> participant [label="Available plans and own coverage history", constraint=false];
  p6 -> operators [label="Assignment / renewal results", constraint=false];
  p6 -> admin [label="Balances; payment history;\nmonthly collections and CSV export", constraint=false];
  user -> p7 [label="Reminder choices and submitted chat messages"];
  d2 -> p7 [label="Scheduled and completed tasks"];
  d3 -> p7 [label="Eligible award / streak context"];
  d4 -> p7 [label="Social and gym updates"];
  d5 -> p7 [label="Coverage expiry dates"];
  p7 -> d7 [label="Reminder settings and notification history"];
  d7 -> p7 [label="Saved preferences and notification state", constraint=false];
  p7 -> ai [label="Submitted conversation only"];
  ai -> p7 [label="Educational response / provider status", constraint=false];
  p7 -> user [label="In-app reminders and educational answers", constraint=false];
  note [shape=note, style=solid, fontsize=10, label="Rounded boxes = processes; rectangles = external entities;\nrecord boxes = logical data stores; arrows = named data flows.\nGym roles also use personal-user functions. All actions are authorized.\nD1–D5 use Supabase services; D6 is bundled reference data;\nD7 is browser/device state. Saved private device copies are cleared on sign-out.\nAccount resets/deletion affect the applicable stores (not all arrows shown).\nReminders run while the app is open; no closed-app push is implied.\nQuiz scores and chat state are transient. Payments are recorded offline receipts.", color="#94a3b8"];
  p7 -> note [style=invis];
}
