digraph DataFlow {
  graph [rankdir=LR, bgcolor=white, pad=0.35, nodesep=0.55, ranksep=0.75, splines=line, fontname="Arial", fontsize=22, fontcolor="#142b55", labelloc=t, label="Figure 4.7: FitSync Data-Flow Diagram, Level 0"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, color="#47658a", penwidth=1.2, margin="0.18,0.16", height=0.8];
  edge [fontname="Arial", fontsize=10, color="#47658a", arrowsize=0.65];
  u1 [fillcolor="#f2f6fb", label="User", width=1.65, group="row1"];
  u2 [fillcolor="#f2f6fb", label="User", width=1.65, group="row2"];
  u3 [fillcolor="#f2f6fb", label="Users and\ngym roles", width=1.65, group="row3"];
  u4 [fillcolor="#f2f6fb", label="Gym staff / admin", width=1.65, group="row4"];
  u5 [fillcolor="#f2f6fb", label="User", width=1.65, group="row5"];
  {rank=same; u1; u2; u3; u4; u5;}
  p1 [fillcolor="#e9f2fc", group="row1", label=<<B>P1</B><BR/>Manage accounts and preferences>, width=3.8];
  p2 [fillcolor="#e9f2fc", group="row2", label=<<B>P2</B><BR/>Plan, log, learn and review progress>, width=3.8];
  p3 [fillcolor="#e9f2fc", group="row3", label=<<B>P3</B><BR/>Manage community, gyms and attendance>, width=3.8];
  p4 [fillcolor="#e9f2fc", group="row4", label=<<B>P4</B><BR/>Manage membership plans and payments>, width=3.8];
  p5 [fillcolor="#e9f2fc", group="row5", label=<<B>P5</B><BR/>Request educational AI assistance>, width=3.8];
  {rank=same; p1; p2; p3; p4; p5;}
  d1 [fillcolor="#e6f3eb", group="row1", label=<<B>D1</B><BR/>Accounts and profiles>, width=2.5];
  d2 [fillcolor="#e6f3eb", group="row2", label=<<B>D2</B><BR/>Plans, playlists, daily logs,<BR/>progress and reference content>, width=2.5];
  d3 [fillcolor="#e6f3eb", group="row3", label=<<B>D3</B><BR/>Gyms, roles, messages,<BR/>activities and visit records>, width=2.5];
  d4 [fillcolor="#e6f3eb", group="row4", label=<<B>D4</B><BR/>Plan offers, coverage<BR/>and payment ledger>, width=2.5];
  ai [fillcolor="#fff2d4", group="row5", label=<<B>External service</B><BR/>OpenRouter AI>, width=2.5];
  {rank=same; d1; d2; d3; d4; ai;}
  u1 -> p1 [label="Account details /\npreferences"];
  p1 -> d1 [dir=both, label="Profile and\naccount records"];
  u2 -> p2 [label="Preferences, choices\nand activity logs"];
  p2 -> d2 [dir=both, label="Saved records /\nreference data"];
  u3 -> p3 [label="Posts, gym requests\nand attendance actions"];
  p3 -> d3 [dir=both, label="Community and\nvisit records"];
  u4 -> p4 [label="Coverage actions /\nreceipts (admin only)"];
  p4 -> d4 [dir=both, label="Coverage and\nfinancial records"];
  u5 -> p5 [label="Fitness or\nnutrition question"];
  p5 -> ai [dir=both, label="Submitted chat /\neducational response"];
  u1 -> u2 -> u3 -> u4 -> u5 [style=invis];
  p1 -> p2 -> p3 -> p4 -> p5 [style=invis];
  d1 -> d2 -> d3 -> d4 -> ai [style=invis];
}
