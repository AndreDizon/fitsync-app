# Set these in the backend Vercel project's environment settings for deployment.
# See ../VERCEL_DEPLOYMENT.md. The coach requires AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, for the manual `npm run seed:demo` command only.
# Keep this server-side; it is not needed by the deployed playlist API.
SUPABASE_SECRET_KEY=
