# Set these in the backend Vercel project's environment settings for deployment.
# See ../VERCEL_DEPLOYMENT.md and ../HOME_SETUP.md.
# Optional: enables the fitness/nutrition chatbot.
OPENROUTER_API_KEY=
# Optional comma-separated free model IDs; only verified zero-priced :free models run.
OPENROUTER_FREE_MODELS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, for the manual `npm run seed:demo` command only.
# Keep this server-side; it is not needed by the deployed playlist API.
SUPABASE_SECRET_KEY=

# Server-only. Required by account data reset/deletion and scheduled storage cleanup.
# Never put this key in NEXT_PUBLIC_* variables or frontend bundles.
SUPABASE_SERVICE_ROLE_KEY=

# Gmail API delivery through the Supabase Send Email Hook (no SMTP).
# All values stay on the backend. See ../GMAIL_AUTH_SETUP.md.
AUTH_EMAIL_SITE_URL=https://fitsync-app-features.vercel.app
SUPABASE_SEND_EMAIL_HOOK_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Required for encrypted plans, playlists and progress. Server only; never NEXT_PUBLIC_.
# Generate an independent random 32-byte hex key. Keep previous keys for old rows.
# See ../PRIVATE_DATA_ENCRYPTION.md before deployment.
PRIVATE_DATA_ENCRYPTION_KEYS=
PRIVATE_DATA_ENCRYPTION_ACTIVE_KEY=v1
