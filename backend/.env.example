# Set these in the backend Vercel project's environment settings for deployment.
# See ../VERCEL_DEPLOYMENT.md and ../HOME_SETUP.md.
# Optional: enables the fitness/nutrition chatbot.
OPENROUTER_API_KEY=
# Optional comma-separated free model IDs; only verified zero-priced :free models run.
OPENROUTER_FREE_MODELS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, for the manual `npm run seed:demo` command only.
# Keep this server-side; it is not needed by the deployed playlist API.
SUPABASE_SECRET_KEY=
